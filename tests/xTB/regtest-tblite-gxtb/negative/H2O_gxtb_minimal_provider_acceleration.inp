&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT H2O_gxtb_minimal_provider_acceleration
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    &KPOINTS
      FULL_GRID ON
      SCHEME MACDONALD 1 1 1 0.0 0.0 0.0
      SYMMETRY OFF
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &QS
      METHOD xTB
      &XTB
        GFN_TYPE TBLITE
        &TBLITE
          ACCURACY 1.0
          METHOD GXTB
          &GXTB_ACCELERATION
            MODE MANUAL
            EXCHANGE_STREAM_BACKEND BATCHED
            ACP_PROJECTOR_CACHE DIRECT
          &END GXTB_ACCELERATION
        &END TBLITE
      &END XTB
    &END QS
    &SCF
      EPS_SCF 1.0E-7
      MAX_SCF 100
      SCF_GUESS MOPAC
      &MIXING
        ALPHA 0.2
        METHOD DIRECT_P_MIXING
      &END MIXING
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      ABC 10.0 10.0 10.0
      PERIODIC XYZ
    &END CELL
    &COORD
      O  5.000000  5.000000  5.000000
      H  5.758602  5.000000  5.504284
      H  4.241398  5.000000  5.504284
    &END COORD
  &END SUBSYS
&END FORCE_EVAL

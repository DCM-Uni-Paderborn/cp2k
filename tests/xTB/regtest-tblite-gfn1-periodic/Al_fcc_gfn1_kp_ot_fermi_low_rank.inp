&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT Al_fcc_gfn1_kp_ot_fermi_low_rank
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    &KPOINTS
      EPS_GEO 1.0E-8
      FULL_GRID ON
      SCHEME MONKHORST-PACK 3 1 1
      SYMMETRY OFF
      VERBOSE T
    &END KPOINTS
    &QS
      METHOD xTB
      &XTB
        GFN_TYPE TBLITE
        &TBLITE
          METHOD GFN1
        &END TBLITE
      &END XTB
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-6
      MAX_SCF 120
      SCF_GUESS MOPAC
      &OT
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        PRECONDITIONER FERMI_LOW_RANK
        ROTATION
      &END OT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      ABC 2.8637824638 2.8637824638 2.8637824638
      ALPHA_BETA_GAMMA 60.0 60.0 60.0
      PERIODIC XYZ
    &END CELL
    &COORD
      Al 0.0 0.0 0.0
    &END COORD
  &END SUBSYS
&END FORCE_EVAL

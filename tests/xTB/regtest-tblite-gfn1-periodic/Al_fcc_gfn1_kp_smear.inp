&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT Al_fcc_gfn1_kp_smear
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  &DFT
    &KPOINTS
      EPS_GEO 1.0E-8
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 3 1 1
      SYMMETRY ON
      VERBOSE T
    &END KPOINTS
    &QS
      METHOD xTB
      &XTB
        GFN_TYPE TBLITE
        &TBLITE
          METHOD GFN1
        &END TBLITE
      &END XTB
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_SCF 1.0E-8
      MAX_SCF 100
      SCF_GUESS MOPAC
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
  &END DFT
  &SUBSYS
    &CELL
      ABC 2.8637824638 2.8637824638 2.8637824638
      ALPHA_BETA_GAMMA 60.0 60.0 60.0
      PERIODIC XYZ
    &END CELL
    &COORD
      Al 0.0 0.0 0.0
    &END COORD
  &END SUBSYS
&END FORCE_EVAL

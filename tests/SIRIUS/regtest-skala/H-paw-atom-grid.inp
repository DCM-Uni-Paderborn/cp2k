! Fixed-geometry integration check, not a converged physical benchmark.
! H-paw-no-core.json is prepared from the core-free PAW setup as described in README.md.
! The radial grid includes points below the first PAW radial sample.
&GLOBAL
  PROJECT H-paw-atom-grid
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD SIRIUS
  &DFT
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          NATIVE_GRID T
          NATIVE_GRID_USE_CUDA F
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PW_DFT
    &SKALA_GRID
      N_RADIAL 100
      N_ANGULAR 110
      IMAGE_SHELL 1
      RADIAL_SCALE 1.0
    &END SKALA_GRID
    &CONTROL
      PROCESSING_UNIT cpu
      GEN_EVP_SOLVER_NAME lapack
      STD_EVP_SOLVER_NAME lapack
      VERBOSITY 1
    &END CONTROL
    &PARAMETERS
      ELECTRONIC_STRUCTURE_METHOD pseudopotential
      GK_CUTOFF 2.6
      PW_CUTOFF 8.0
      NGRIDK 1 1 1
      SHIFTK 1 0 0
      NUM_BANDS 4
      USE_SYMMETRY F
      DENSITY_TOL 2e-6
      ENERGY_TOL 2e-7
      NUM_DFT_ITER 150
      SMEARING_WIDTH 0.01
    &END PARAMETERS
    &ITERATIVE_SOLVER
      TYPE exact
      MIN_TOLERANCE 1e-11
      ENERGY_TOLERANCE 1e-9
      NUM_STEPS 80
    &END ITERATIVE_SOLVER
    &MIXER
      TYPE linear
      BETA 0.2
      USE_HARTREE F
    &END MIXER
  &END PW_DFT
  &SUBSYS
    &CELL
      ABC [bohr] 8.0 9.0 10.0
    &END CELL
    &COORD
      SCALED
      H 0.2 0.3 0.4
    &END COORD
    &KIND H
      POTENTIAL UPF H-paw-no-core.json
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

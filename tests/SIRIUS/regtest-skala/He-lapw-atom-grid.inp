! Fixed-geometry integration check, not a converged physical benchmark.
! Generate He-lapw.json with tools/regtesting/create_sirius_lapw_test_atom.py.
&GLOBAL
  PROJECT He-lapw-atom-grid
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD SIRIUS
  STRESS_TENSOR ANALYTICAL
  &DFT
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          NATIVE_GRID T
          NATIVE_GRID_USE_CUDA F
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PW_DFT
    &SKALA_GRID
      N_RADIAL 100
      N_ANGULAR 110
      IMAGE_SHELL 1
      RADIAL_SCALE 1.0
      EPS_RESPONSE 1e-6
    &END SKALA_GRID
    &CONTROL
      PROCESSING_UNIT cpu
      GEN_EVP_SOLVER_NAME lapack
      STD_EVP_SOLVER_NAME lapack
      VERBOSITY 1
    &END CONTROL
    &PARAMETERS
      ELECTRONIC_STRUCTURE_METHOD full_potential_lapwlo
      GK_CUTOFF 1.5
      PW_CUTOFF 5.0
      NGRIDK 1 1 1
      SHIFTK 1 0 0
      NUM_BANDS 4
      USE_SYMMETRY F
      AUTO_RMT 0
      CORE_RELATIVITY none
      VALENCE_RELATIVITY none
      LMAX_APW 3
      LMAX_RHO 6
      LMAX_POT 6
      DENSITY_TOL 1e-8
      ENERGY_TOL 1e-9
      NUM_DFT_ITER 300
      SMEARING_WIDTH 0.01
    &END PARAMETERS
    &SETTINGS
      RADIAL_GRID "power, 2.0"
    &END SETTINGS
    &ITERATIVE_SOLVER
      TYPE exact
      MIN_TOLERANCE 1e-11
    &END ITERATIVE_SOLVER
    &MIXER
      TYPE linear
      BETA 0.2
      USE_HARTREE F
    &END MIXER
  &END PW_DFT
  &SUBSYS
    &CELL
      ABC [bohr] 8.0 9.0 10.0
    &END CELL
    &COORD
      SCALED
      He 0.2 0.3 0.4
    &END COORD
    &KIND He
      POTENTIAL ALL
      SIRIUS_ATOM_FILE He-lapw.json
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL

! Fixed-geometry integration check with a separately solved 1s core.
! Generate Ne-lapw.json with create_sirius_lapw_test_atom.py --element Ne.
&GLOBAL
  PROJECT Ne-lapw-atom-grid
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD SIRIUS
  &DFT
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          NATIVE_GRID T
          NATIVE_GRID_USE_CUDA F
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PW_DFT
    &SKALA_GRID
      N_RADIAL 3200
      N_ANGULAR 110
      IMAGE_SHELL 1
      RADIAL_SCALE 1.0
    &END SKALA_GRID
    &CONTROL
      PROCESSING_UNIT cpu
      GEN_EVP_SOLVER_NAME lapack
      STD_EVP_SOLVER_NAME lapack
      VERBOSITY 1
    &END CONTROL
    &PARAMETERS
      ELECTRONIC_STRUCTURE_METHOD full_potential_lapwlo
      GK_CUTOFF 1.5
      PW_CUTOFF 5.0
      NGRIDK 1 1 1
      SHIFTK 1 0 0
      NUM_BANDS 8
      USE_SYMMETRY F
      AUTO_RMT 0
      CORE_RELATIVITY none
      VALENCE_RELATIVITY none
      LMAX_APW 3
      LMAX_RHO 6
      LMAX_POT 6
      DENSITY_TOL 2e-6
      ENERGY_TOL 2e-7
      NUM_DFT_ITER 150
      SMEARING_WIDTH 0.01
    &END PARAMETERS
    &SETTINGS
      RADIAL_GRID "power, 2.0"
    &END SETTINGS
    &ITERATIVE_SOLVER
      TYPE exact
      MIN_TOLERANCE 1e-11
    &END ITERATIVE_SOLVER
    &MIXER
      TYPE linear
      BETA 0.2
      USE_HARTREE F
    &END MIXER
  &END PW_DFT
  &SUBSYS
    &CELL
      ABC [bohr] 8.0 9.0 10.0
    &END CELL
    &COORD
      SCALED
      Ne 0.2 0.3 0.4
    &END COORD
    &KIND Ne
      POTENTIAL ALL
      SIRIUS_ATOM_FILE Ne-lapw.json
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&GLOBAL
  PROJECT H-spin-skala-sirius
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD SIRIUS
  STRESS_TENSOR ANALYTICAL
  &DFT
    UKS T
    MULTIPLICITY 2
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          NATIVE_GRID T
          NATIVE_GRID_USE_CUDA F
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PW_DFT
    &SKALA_GRID
      N_RADIAL 100
      N_ANGULAR 110
      IMAGE_SHELL 1
      RADIAL_SCALE 1.0
    &END SKALA_GRID
    &CONTROL
      PROCESSING_UNIT cpu
      GEN_EVP_SOLVER_NAME lapack
      STD_EVP_SOLVER_NAME lapack
      VERBOSITY 1
    &END CONTROL
    &PARAMETERS
      ELECTRONIC_STRUCTURE_METHOD pseudopotential
      GK_CUTOFF 2.6
      PW_CUTOFF 6.0
      NGRIDK 2 1 1
      SHIFTK 1 0 0
      NUM_MAG_DIMS 1
      FIXED_MAG 1.0
      NUM_BANDS 4
      USE_SYMMETRY F
      DENSITY_TOL 1e-7
      ENERGY_TOL 1e-8
      NUM_DFT_ITER 150
      SMEARING_WIDTH 0.001
    &END PARAMETERS
    &ITERATIVE_SOLVER
      TYPE exact
      ENERGY_TOLERANCE 1e-9
      NUM_STEPS 100
    &END ITERATIVE_SOLVER
    &MIXER
      TYPE broyden2
      BETA 0.1
      MAX_HISTORY 8
    &END MIXER
  &END PW_DFT
  &SUBSYS
    &CELL
      ABC [bohr] 6.0 6.0 6.0
    &END CELL
    &COORD
      SCALED
      H 0.30 0.40 0.30
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q1
      MAGNETIZATION 1
    &END KIND
  &END SUBSYS
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
&END FORCE_EVAL

&GLOBAL
  PROJECT H2-skala-sirius
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD SIRIUS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          NATIVE_GRID T
          NATIVE_GRID_USE_CUDA F
          NATIVE_GRID_ATOM_PARTITION SMOOTH
          NATIVE_GRID_ATOM_CHUNKS T
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PW_DFT
    &CONTROL
      PROCESSING_UNIT cpu
      GEN_EVP_SOLVER_NAME lapack
      STD_EVP_SOLVER_NAME lapack
      VERBOSITY 1
    &END CONTROL
    &PARAMETERS
      ELECTRONIC_STRUCTURE_METHOD pseudopotential
      GK_CUTOFF 2.6
      PW_CUTOFF 6.0
      NGRIDK 1 1 1
      NUM_BANDS 4
      USE_SYMMETRY F
      DENSITY_TOL 1e-7
      ENERGY_TOL 1e-8
      NUM_DFT_ITER 100
      SMEARING_WIDTH 0.001
    &END PARAMETERS
    &ITERATIVE_SOLVER
      TYPE davidson
      ENERGY_TOLERANCE 1e-9
      NUM_STEPS 100
    &END ITERATIVE_SOLVER
    &MIXER
      TYPE linear
      BETA 0.3
    &END MIXER
  &END PW_DFT
  &SUBSYS
    &CELL
      ABC [bohr] 6.0 6.0 6.0
    &END CELL
    &COORD
      SCALED
      H 0.30 0.40 0.30
      H 0.55 0.45 0.50
    &END COORD
    &KIND H
      BASIS_SET DZVP-MOLOPT-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

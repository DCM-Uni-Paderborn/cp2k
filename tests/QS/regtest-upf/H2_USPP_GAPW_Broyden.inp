&GLOBAL
  PROJECT H2_USPP_GAPW_Broyden
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
    &MGRID
      CUTOFF 12
      REL_CUTOFF 10
    &END MGRID
    &QS
      EPS_DEFAULT 1.E-10
      METHOD GAPW
      USPP_METHOD DIRECT
    &END QS
    &SCF
      EPS_SCF 1.E-11
      MAX_SCF 3
      IGNORE_CONVERGENCE_FAILURE
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
      &END MIXING
    &END SCF
    &XC
      &XC_GRID
        XC_DERIV PW
        XC_SMOOTH_RHO NONE
      &END XC_GRID
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC [bohr] 7.0 6.4 6.7
    &END CELL
    &COORD
      UNIT bohr
      H 2.0 3.0 3.0
      H 5.0 3.3 3.4
    &END COORD
    &KIND H
      RADIAL_GRID 15
      LEBEDEV_GRID 26
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q1
      POTENTIAL UPF H.us.pbe.z_1.ld1.psl.v1.0.0-high-full-waves.upf
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

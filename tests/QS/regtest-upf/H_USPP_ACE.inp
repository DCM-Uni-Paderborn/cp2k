&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT H_USPP_ACE
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_RI_IMAGE
    CHARGE -1
    &MGRID
      CUTOFF 20
      REL_CUTOFF 10
    &END MGRID
    &QS
      EPS_DEFAULT 1.E-10
      EPS_PGF_ORB 1.E-10
      METHOD GAPW_XC
      USPP_METHOD INVERSE_1C
    &END QS
    &SCF
      EPS_SCF 1.E-11
      MAX_SCF 80
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.3
        METHOD DIRECT_P_MIXING
      &END MIXING
    &END SCF
    &XC
      &HF
        FRACTION 0.25
        &ACE
          ACTIVE TRUE
          REBUILD_FREQUENCY 3
        &END ACE
        &INTERACTION_POTENTIAL
          OMEGA 10.0
          POTENTIAL_TYPE SHORTRANGE
        &END INTERACTION_POTENTIAL
        &RI
          EPS_FILTER 1.E-10
          EPS_PGF_ORB 1.E-10
          KP_NGROUPS 1
          RI_FLAVOR RHO
          RI_METRIC IDENTITY
        &END RI
        &SCREENING
          EPS_SCHWARZ 1.E-10
        &END SCREENING
      &END HF
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
  &SUBSYS
    &CELL
      ABC [bohr] 12.0 12.4 12.8
      PERIODIC XYZ
    &END CELL
    &COORD
      UNIT bohr
      H 2.0 3.0 3.0
    &END COORD
    &KIND H
      BASIS_SET COMPACT
      BASIS_SET RI_HFX DIFFUSE_RI
      LEBEDEV_GRID 14
      POTENTIAL UPF H.us.pbe.z_1.ld1.psl.v1.0.0-high-full-waves.upf
      RADIAL_GRID 10
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

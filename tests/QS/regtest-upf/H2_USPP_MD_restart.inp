&GLOBAL
  PROJECT H2_USPP_MD_restart
  RUN_TYPE MD
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    &KPOINTS
      SCHEME GENERAL
      KPOINT 0.0000000000000000 0.0000000000000000 0.0 0.2
      KPOINT 0.3333333333333333 0.0000000000000000 0.0 0.2
      KPOINT -0.3333333333333333 0.0000000000000000 0.0 0.2
      KPOINT 0.0000000000000000 0.3333333333333333 0.0 0.2
      KPOINT 0.0000000000000000 -0.3333333333333333 0.0 0.2
      FULL_GRID FALSE
      SYMMETRY TRUE
      WAVEFUNCTIONS COMPLEX
      LATTICE_FFT OFF
      PARALLEL_GROUP_SIZE 0
    &END KPOINTS
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    &MGRID
      CUTOFF 20
      REL_CUTOFF 10
    &END MGRID
    &QS
      METHOD GPW
      USPP_METHOD DIRECT
      EXTRAPOLATION USE_GUESS
      EPS_DEFAULT 1.E-10
    &END QS
    &SCF
      SCF_GUESS RESTART
      &PRINT
        &RESTART ON
          ADD_LAST NUMERIC
        &END RESTART
      &END PRINT
      EPS_SCF 2.E-9
      EPS_DIIS 0.0
      MAX_SCF 30
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.3
        NBUFFER 6
        N_SIMPLE_MIX 2
      &END MIXING
    &END SCF
    &XC
      &XC_GRID
        XC_DERIV PW
        XC_SMOOTH_RHO NONE
      &END XC_GRID
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC [bohr] 7.0 7.0 9.0
      PERIODIC XYZ
    &END CELL
    &COORD
      UNIT BOHR
      H 0.0 0.0 3.25
      H 0.0 0.0 5.75
    &END COORD
    &VELOCITY
      0.002 0.001 0.0
     -0.002 -0.001 0.0
    &END VELOCITY
    &KIND H
      BASIS_SET SZV-MOLOPT-SR-GTH-q1
      POTENTIAL UPF H.us.pbe.z_1.ld1.psl.v1.0.0-high-full-waves.upf
      RADIAL_GRID 15
      LEBEDEV_GRID 26
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&MOTION
  &MD
    ENSEMBLE NVE
    STEPS 1
    TIMESTEP 0.1
  &END MD
&END MOTION

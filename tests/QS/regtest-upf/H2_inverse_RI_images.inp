&GLOBAL
  PROJECT H2_inverse_RI_images
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_RI_IMAGE
    &KPOINTS
      SCHEME GENERAL
      KPOINT 0.0 0.0 0.0 1.0
      FULL_GRID TRUE
      SYMMETRY FALSE
      WAVEFUNCTIONS COMPLEX
      LATTICE_FFT OFF
      PARALLEL_GROUP_SIZE 0
    &END KPOINTS
    &MGRID
      CUTOFF 20
      REL_CUTOFF 10
    &END MGRID
    &QS
      METHOD GAPW_XC
      USPP_METHOD INVERSE
      EPS_DEFAULT 1.E-10
      EPS_PGF_ORB 1.E-10
    &END QS
    &SCF
      MAX_SCF 30
      EPS_SCF 1.E-11
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &HF
        FRACTION 0.25
        &INTERACTION_POTENTIAL
          POTENTIAL_TYPE SHORTRANGE
          OMEGA 10.0
        &END INTERACTION_POTENTIAL
        &SCREENING
          EPS_SCHWARZ 1.E-10
        &END SCREENING
        &RI
          RI_FLAVOR RHO
          RI_METRIC IDENTITY
          EPS_FILTER 1.E-10
          EPS_PGF_ORB 1.E-10
          KP_NGROUPS 1
        &END RI
      &END HF
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC [bohr] 12.0 12.4 12.8
      PERIODIC XYZ
    &END CELL
    &COORD
      UNIT bohr
      H 5.3 6.2 6.4
      H 6.7 6.2 6.4
    &END COORD
    &KIND H
      BASIS_SET COMPACT
      BASIS_SET RI_HFX DIFFUSE_RI
      POTENTIAL UPF UPF/H.us.pbe.z_1.ld1.psl.v1.0.0-high-full-waves.upf
      RADIAL_GRID 10
      LEBEDEV_GRID 14
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

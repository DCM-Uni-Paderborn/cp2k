&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT He_PAW_GAPW
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH_2026.2
    CHARGE 0
    &MGRID
      CUTOFF 120
      REL_CUTOFF 30
    &END MGRID
    &QS
      EPS_DEFAULT 1.E-10
      FORCE_PAW TRUE
      METHOD GAPW
    &END QS
    &SCF
      EPS_SCF 1.E-12
      MAX_SCF 80
      SCF_GUESS ATOMIC
      &OT
        ENERGY_GAP 0.001
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
    &END SCF
    &XC
      DENSITY_CUTOFF 1.E-14
      GRADIENT_CUTOFF 1.E-14
      &XC_FUNCTIONAL
        &TPSS
        &END TPSS
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
  &SUBSYS
    &CELL
      ABC 4 4 4
    &END CELL
    &COORD
      He 1.1 1.2 1.3
    &END COORD
    &KIND He
      BASIS_SET DZVP-MOLOPT-PBE-GTH-q2
      HARD_EXP_RADIUS 1.2
      LEBEDEV_GRID 26
      POTENTIAL UPF He.paw.pbe.z_2.ld1.psl.v1.0.0-high.upf
      RADIAL_GRID 80
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

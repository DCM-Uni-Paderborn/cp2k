&GLOBAL
  PRINT_LEVEL LOW
  PROJECT ${PROJECT}
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME ${POTENTIAL_FILE}
    &KPOINTS
      FULL_GRID T
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY F
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
    &END MGRID
    &PRINT
      &WANNIER90 ON
        ADDED_MOS ${EXPORT_ADDED}
        ATOMIC_SIGNATURES T
        EXCLUDE_BANDS ${EXCLUDED}
        KPOINTS_SOURCE SYMMETRY
        REQUIRE_GLOBAL_GAP T
        SEED_NAME ${PROJECT}
        SOC ${SOC}
        TIME_REVERSAL T
      &END WANNIER90
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-14
      EPS_PPNL 1.0E-14
      METHOD ${METHOD}
    &END QS
    &SCF
      ADDED_MOS 1
      EPS_SCF 1.0E-11
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.4
        METHOD BROYDEN_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 4 0 0
      B 0 5 0
      C ${SHEAR} 0 8
    &END CELL
    &COORD
      SCALED
      ${ELEMENT} 0.13 0.21 0
      ${ELEMENT} ${SECOND_X} -0.21 0.5
    &END COORD
    &KIND ${ELEMENT}
      BASIS_SET ${BASIS}
      POTENTIAL ${POTENTIAL}
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

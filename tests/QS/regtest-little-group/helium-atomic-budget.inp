&GLOBAL
  PRINT_LEVEL LOW
  PROJECT helium-atomic-budget
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &KPOINTS
      FULL_GRID T
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY F
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
    &END MGRID
    &PRINT
      &WANNIER90 ON
        ATOMIC_SIGNATURES T
        ATOMIC_SIGNATURE_MAX_NODES 0
        EXCLUDE_BANDS 2
        KPOINTS_SOURCE TRIM
        SEED_NAME helium-atomic-budget
        TIME_REVERSAL T
      &END WANNIER90
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GPW
    &END QS
    &SCF
      ADDED_MOS 1
      EPS_SCF 1.0E-11
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.4
        METHOD BROYDEN_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4 5 6
    &END CELL
    &COORD
      SCALED
      He 0.5 0.5 0.5
    &END COORD
    &KIND He
      BASIS_SET DZVP-MOLOPT-GGA-GTH-q2
      POTENTIAL GTH-GGA-q2
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

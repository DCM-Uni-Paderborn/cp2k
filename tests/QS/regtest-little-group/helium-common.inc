&GLOBAL
  PRINT_LEVEL LOW
  PROJECT ${PROJECT}
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &KPOINTS
      FULL_GRID T
      SCHEME MONKHORST-PACK 2 2 2
      SYMMETRY F
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
    &END MGRID
    &PRINT
      &WANNIER90 ON
        EXCLUDE_BANDS ${EXCLUDED}
        KPOINTS_SOURCE NNKP
        NNKP_FILE ${NNKP}
        SEED_NAME ${PROJECT}
        TIME_REVERSAL ${USE_TIME_REVERSAL}
        LITTLE_GROUP_COMPATIBILITY T
        ATOMIC_SIGNATURES T
      &END WANNIER90
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-12
      EPS_PGF_ORB 1.0E-14
      METHOD ${METHOD}
    &END QS
    &SCF
      ADDED_MOS 1
      EPS_SCF 1.0E-11
      MAX_SCF 100
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.4
        METHOD BROYDEN_MIXING
      &END MIXING
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      A 4 0 0
      B 0 5 0
      C ${SHEAR} 0 8
    &END CELL
    &COORD
      SCALED
      He ${FIRST_X} ${FIRST_Y} 0
      He ${SECOND_X} ${SECOND_Y} 0.5
    &END COORD
    &KIND He
      BASIS_SET ${BASIS}
      POTENTIAL ${POTENTIAL}
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

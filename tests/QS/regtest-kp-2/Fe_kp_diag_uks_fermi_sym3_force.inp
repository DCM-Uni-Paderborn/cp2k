! Slow/manual direct-mixing diagonalization force and stress reference for
! Fe_kp_ot_uks_added_auto_sym3_diis_force.inp. Run the converged
! Fe_kp_diag_uks_fermi_sym3_converge.inp first. This input is intentionally
! not listed in TEST_FILES.toml.
!
! The MPI-2/OMP-2 EPS_SCF=1E-9 reference converges in 15 steps at
! F=-123.63311572154215 Ha. The matching OT force companion differs by
! 3.7E-12 Ha in energy and 0.27 bar in analytical stress; the one-atom force
! is numerical zero in both methods.
&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT Fe_kp_diag_uks_fermi_sym3_force
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    MULTIPLICITY 3
    POTENTIAL_FILE_NAME POTENTIAL
    UKS TRUE
    WFN_RESTART_FILE_NAME Fe_kp_diag_uks_fermi_sym3_converge-RESTART.kp
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 3 1 1
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 300
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS 16
      EPS_SCF 1.0E-9
      MAX_SCF 100
      SCF_GUESS RESTART
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.05
        METHOD DIRECT_P_MIXING
      &END MIXING
      &SMEAR
        ELECTRONIC_TEMPERATURE 1000
        FIXED_MAGNETIC_MOMENT 2.0
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
  &PROPERTIES
    &FIT_CHARGE OFF
    &END FIT_CHARGE
  &END PROPERTIES
  &SUBSYS
    &CELL
      A -1.435 1.435 1.435
      B 1.435 -1.435 1.435
      C 1.435 1.435 -1.435
    &END CELL
    &COORD
      Fe 0.000 0.000 0.000
    &END COORD
    &KIND Fe
      BASIS_SET DZVP-MOLOPT-SR-GTH-q16
      MAGNETIZATION 2.0
      POTENTIAL GTH-PADE-q16
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

! Slow/manual force companion for the converged symmetry-reduced metallic
! k-point OT path. Run Al_kp_ot_added_auto_sym3_converge.inp first so that its
! project restart is available. This input is intentionally not listed in
! TEST_FILES.toml and therefore does not make the default regtest expensive.
!
! The 2026-08 MPI-2/OMP-2 reference reaches Mermin
! F = -8.15998707756201 Ha at EPS_SCF 1E-8; a converged restart closes in one
! step. Relative to Al_kp_diag_fermi_sym3_force.inp, the energy differs by
! 9.3E-11 Ha, the largest force-component difference is 4.3E-7 Ha/bohr, and
! the largest analytical-stress-component difference is 0.52 bar.
! A runtime-check OMP-2 continuation from the EPS_SCF 1E-6 AUTO restart reaches
! F = -8.15998707994740 Ha in 136 steps; against its matching diagonalization
! run the energy, force-component, and stress-component differences are
! 2.3E-9 Ha, 5.24E-7 Ha/bohr, and 0.52 bar, respectively.
&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT Al_kp_ot_added_auto_sym3_converge
  RUN_TYPE ENERGY_FORCE
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 3 1 1
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 40
    &END MGRID
    &PRINT
      &KPOINTS ON
      &END KPOINTS
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS 16
      EPS_SCF 1.0E-8
      MAX_SCF 240
      SCF_GUESS RESTART
      &OT
        ALGORITHM IRAC
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_SINGLE_INVERSE
        ROTATION
      &END OT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON
    &END STRESS_TENSOR
  &END PRINT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
    &END CELL
    &COORD
      Al        -0.4201082476       -0.4201082770       -0.4201082658
      Al         2.1120503717        0.1540265147        0.1540265525
      Al         0.1540266214        2.1120506065        0.1540265605
      Al         0.1540266183        0.1540265196        2.1120505165
    &END COORD
    &KIND Al
      BASIS_SET DZVP-GTH-PADE-CONFINED
      POTENTIAL GTH-PADE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

! Compact converged metallic k-point OT restart writer. The matching
! diagonalization reference is Al_sc_kp_diag_fermi.inp.
&GLOBAL
  PRINT_LEVEL LOW
  PROJECT Al_kp_ot_restart
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 3 1 1
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 40
    &END MGRID
    &PRINT
      &KPOINTS ON
      &END KPOINTS
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-7
      MAX_SCF 80
      SCF_GUESS ATOMIC
      &OT
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        ROTATION
      &END OT
      &PRINT
        &RESTART ON
          BACKUP_COPIES 0
          &EACH
            QS_SCF 1
          &END EACH
        &END RESTART
      &END PRINT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.05 4.05 4.05
    &END CELL
    &COORD
      SCALED
      Al 0.0 0.0 0.0
    &END COORD
    &KIND Al
      BASIS_SET DZVP-GTH-PADE-CONFINED
      POTENTIAL GTH-PADE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

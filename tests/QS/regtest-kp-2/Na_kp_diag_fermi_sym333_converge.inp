! Slow/manual diagonalization reference for the symmetry-reduced metallic
! k-point OT companion. This input is intentionally not listed in
! TEST_FILES.toml so the default regression suite remains inexpensive.
! It uses the same 3x3x3 mesh, 16-MO space, temperature, basis, potential,
! and fixed total electron number as Na_kp_ot_added_auto_sym333_converge.inp.
! Local MPI-2/OMP-2 reference: 25 SCF steps at
! F = -9.01953179333602 Ha and chemical potential -0.07884967802581 Ha.
&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT Na_kp_diag_fermi_sym333_converge
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 3 3 3
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS 16
      EPS_SCF 1.0E-8
      MAX_SCF 240
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.2
        BETA 1.5
        METHOD BROYDEN_MIXING
        NBUFFER 8
      &END MIXING
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.23 4.23 4.23
    &END CELL
    &COORD
      Na 0.000 0.000 0.000
      Na 2.115 2.115 2.115
    &END COORD
    &KIND Na
      BASIS_SET DZVP-GTH-PADE
      POTENTIAL GTH-PADE-q9
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

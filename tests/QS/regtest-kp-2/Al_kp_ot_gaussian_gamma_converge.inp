! Slow/manual companion for Gaussian-smearing OT at the explicit Gamma
! k-point. This input is intentionally not listed in TEST_FILES.toml while
! the common Gamma/k-point driver path is being validated.
! Isolated 2026-07 MPI-2 reference: ADDED_MOS AUTO grows 4->8->16->32->46.
! Growth stages use 105/48/22/22 OT steps; the final complete-space stage
! converges in 121 steps at an accepted endpoint without flat-tail recovery.
! Mermin F = -8.14303707487464 Ha, the smearing correction is
! -1.07200934298E-3 Ha, and the physical Fermi energy is
! -5.3869300009E-2 Ha. The complete-space diagonalization reference is
! -8.14303708264791 Ha, a difference of 7.8E-9 Ha.
&GLOBAL
  PRINT_LEVEL HIGH
  PROJECT Al_kp_ot_gaussian_gamma_converge
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 1 1 1
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 40
    &END MGRID
    &PRINT
      &KPOINTS ON
      &END KPOINTS
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-6
      MAX_SCF 320
      SCF_GUESS ATOMIC
      &OT
        ALGORITHM IRAC
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_SINGLE_INVERSE
        ROTATION
      &END OT
      &SMEAR
        METHOD GAUSSIAN
        SIGMA [eV] 0.025852
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
    &END CELL
    &COORD
      Al        -0.4201082476       -0.4201082770       -0.4201082658
      Al         2.1120503717        0.1540265147        0.1540265525
      Al         0.1540266214        2.1120506065        0.1540265605
      Al         0.1540266183        0.1540265196        2.1120505165
    &END COORD
    &KIND Al
      BASIS_SET DZVP-GTH-PADE-CONFINED
      POTENTIAL GTH-PADE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

! Slow/manual low-temperature transition-metal companion. This input is
! intentionally not listed in TEST_FILES.toml so the default regression suite
! remains inexpensive. It exercises four complex (spin,k-point) channels, a
! fixed magnetic moment, a sharp d-band Fermi frontier, symmetry weights,
! ADDED_MOS AUTO, and FULL_ALL occupation preconditioning.
!
! AUTO grows (4,6)->(8,10)->(16,18), preserving common 13->17->25 MO
! spaces. If an accepted-step path exhausts 240 CG steps, the existing
! Outer-SCF EPS_DIIS handoff starts a fresh DIIS history instead of merely
! raising the limit. With the fixed-label Mermin mixed response, current
! references are 315 total evaluations on MPI-4/OMP-1 and 367 on MPI-2/OMP-2,
! at F=-123.63026684851916 and -123.63026682953948 Ha, respectively. The
! restart companion must close in one step without replaying AUTO growth or
! rebuilding the physical subspace.
&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT Fe_kp_ot_uks_added_auto_sym3_300K_converge
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    MULTIPLICITY 3
    POTENTIAL_FILE_NAME POTENTIAL
    UKS TRUE
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 3 1 1
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 300
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_DIIS 2.0E-4
      EPS_SCF 1.0E-6
      MAX_SCF 240
      SCF_GUESS ATOMIC
      &OT
        ENERGIES
        LINESEARCH 2PNT
        MAX_SCF_DIIS 240
        MINIMIZER CG
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_ALL
        ROTATION
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 2
      &END OUTER_SCF
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        FIXED_MAGNETIC_MOMENT 2.0
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &FIT_CHARGE OFF
    &END FIT_CHARGE
  &END PROPERTIES
  &SUBSYS
    &CELL
      A -1.435 1.435 1.435
      B 1.435 -1.435 1.435
      C 1.435 1.435 -1.435
    &END CELL
    &COORD
      Fe 0.000 0.000 0.000
    &END COORD
    &KIND Fe
      BASIS_SET DZVP-MOLOPT-SR-GTH-q16
      MAGNETIZATION 2.0
      POTENTIAL GTH-PADE-q16
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

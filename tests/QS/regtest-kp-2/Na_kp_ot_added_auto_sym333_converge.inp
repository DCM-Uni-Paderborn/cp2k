! Slow/manual companion for converged metallic k-point OT physics.  This input
! is intentionally not listed in TEST_FILES.toml so the default regression
! suite remains inexpensive.  It exercises a common fixed-N chemical
! potential, nontrivial irreducible k-point weights, ADDED_MOS AUTO, complex
! rotations, auxiliary energies, and the occupation preconditioner.
! Local MPI-2/OMP-2 references: AUTO grows 4->8->16 and converges in roughly
! 285-385 final-space steps at F = -9.0195318012 Ha. Rate-aware orbital-tail
! rebases use the complete fixed-N physical residual; the same case required
! more than 500 steps before that residual was available to the refresh gate.
! Restarting the resulting checkpoint at EPS_SCF 1E-7 converges in one step at
! the same printed endpoint. From that checkpoint the strict 1E-8 companion can
! reach a complete fixed-N Mermin endpoint, but some trajectories still retain
! a complete physical residual just above 1E-8 after 360 steps. It remains a
! manual residual-tail stress test rather than a deterministic regression.
&GLOBAL
  PRINT_LEVEL HIGH
  PROJECT Na_kp_ot_added_auto_sym333_converge
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 3 3 3
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-7
      MAX_SCF 900
      SCF_GUESS ATOMIC
      &OT
        ALGORITHM IRAC
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_ALL
        ROTATION
      &END OT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.23 4.23 4.23
    &END CELL
    &COORD
      Na 0.000 0.000 0.000
      Na 2.115 2.115 2.115
    &END COORD
    &KIND Na
      BASIS_SET DZVP-GTH-PADE
      POTENTIAL GTH-PADE-q9
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

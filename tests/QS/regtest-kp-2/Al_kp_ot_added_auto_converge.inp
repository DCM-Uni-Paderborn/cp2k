! Slow/manual companion to the cheap ADDED_MOS AUTO k-point OT smoke test.
! This input is intentionally not listed in TEST_FILES.toml so the default
! regtest stays cheap.  It exercises the adaptive AUTO tail grow/rebuild path.
! Local 2026-07 HIGH reference from an isolated working directory after
! residual-aware Schur response trust and edge-gated residual AUTO growth:
! initial AUTO buffer 4, grow to 8 only, then final convergence in 110 OT
! steps after the rebuild.  Total OT lines across AUTO rebuilds: 276.
! E_total = Mermin = -8.14585274623751 Ha, with no first/last-band warnings
! and no AUTO-exhausted warning.  Run this companion from a fresh CWD because
! PROJECT files are written there and stale Al_kp_ot_added_auto* files make
! diagnosis ambiguous.  The final tail is no longer solved by growing into an
! empty virtual edge; remaining slowness is a response/Hessian issue.
&GLOBAL
  PRINT_LEVEL HIGH
  PROJECT Al_kp_ot_added_auto
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 2 1 1
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 40
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-6
      MAX_SCF 950
      SCF_GUESS ATOMIC
      &OT
        ALGORITHM IRAC
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_SINGLE_INVERSE
        ROTATION
      &END OT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
    &END CELL
    &COORD
      Al        -0.4201082476       -0.4201082770       -0.4201082658
      Al         2.1120503717        0.1540265147        0.1540265525
      Al         0.1540266214        2.1120506065        0.1540265605
      Al         0.1540266183        0.1540265196        2.1120505165
    &END COORD
    &KIND Al
      BASIS_SET DZVP-GTH-PADE-CONFINED
      POTENTIAL GTH-PADE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

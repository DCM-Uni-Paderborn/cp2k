! Strict manual residual-tail companion for
! Na_kp_ot_added_auto_sym333_converge.inp. Run the source input first in the
! same directory. Local MPI-2/OMP-2 reference: 104 OT steps at EPS_SCF 1E-8,
! with F = -9.01953181739052 Ha and no band-edge warning. This input is
! intentionally not listed in TEST_FILES.toml.
&GLOBAL
  PRINT_LEVEL HIGH
  PROJECT Na_kp_ot_added_auto_sym333_restart_strict
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME Na_kp_ot_added_auto_sym333_converge-RESTART.kp
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 3 3 3
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-8
      MAX_SCF 240
      SCF_GUESS RESTART
      &OT
        ALGORITHM IRAC
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_SINGLE_INVERSE
        ROTATION
      &END OT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.23 4.23 4.23
    &END CELL
    &COORD
      Na 0.000 0.000 0.000
      Na 2.115 2.115 2.115
    &END COORD
    &KIND Na
      BASIS_SET DZVP-GTH-PADE
      POTENTIAL GTH-PADE-q9
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

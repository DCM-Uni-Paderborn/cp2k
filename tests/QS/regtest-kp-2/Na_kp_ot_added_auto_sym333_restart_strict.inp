! Strict manual residual-tail companion for
! Na_kp_ot_added_auto_sym333_converge.inp. Run the source input first in the
! same directory. The sign-aware dense Schur model retains an absolute-
! curvature saddle-escape direction when no negative-mode mixture can lower
! the local linear residual. Favorable MPI-2/OMP-2 trajectories reached complete
! fixed-N Mermin endpoints, but others still stop after 360 steps with the
! complete physical residual slightly above 1E-8. This remains an intentionally
! unlisted residual-tail stress test so the default suite stays inexpensive and
! does not claim deterministic strict convergence prematurely.
&GLOBAL
  PRINT_LEVEL HIGH
  PROJECT Na_kp_ot_added_auto_sym333_restart_strict
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME Na_kp_ot_added_auto_sym333_converge-RESTART.kp
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 3 3 3
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 50
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-8
      MAX_SCF 360
      SCF_GUESS RESTART
      &OT
        ALGORITHM IRAC
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_ALL
        ROTATION
      &END OT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.23 4.23 4.23
    &END CELL
    &COORD
      Na 0.000 0.000 0.000
      Na 2.115 2.115 2.115
    &END COORD
    &KIND Na
      BASIS_SET DZVP-GTH-PADE
      POTENTIAL GTH-PADE-q9
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

! Slow/manual companion to the default k-point OT restart smoke test.
! Run repeatedly after Al_kp_ot_restart_write/read/continue.inp; this input is
! not listed in TEST_FILES.toml so the default restart/smearing regtest stays
! cheap.
! A late-tail 2026-07 HIGH run reached OT residual 9.96E-7 in 201 further SCF
! steps with Mermin free energy -8.14585265951153 Ha.  That timing must not be
! attributed to a fresh write/read/continue chain: a clean reproduction at
! 83a57634a4 reached -8.14564233907172 Ha after continue and remained at
! residual 2.21E-5 after two further 320-step companions.  Treat the 1E-6
! result as a physical endpoint reference for an already advanced tail restart.
! Its final-restart guard reconverged in one SCF step at -8.14585265981938 Ha.
! No first/last-band warning or "Unsupported content type" signature occurred.
! This is still intentionally a continuation companion, not a default
! converged regtest.
! Keep this as a manual physics companion until the fresh write/read/continue
! chain is fast enough for a non-default converged 1E-6 regtest.
&GLOBAL
  PRINT_LEVEL HIGH
  PROJECT Al_kp_ot_restart
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 2 1 1
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 40
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS 12
      ! Tight enough to exercise the hard k-point OT physics path.  This
      ! companion is intentionally not part of the default regtest list.
      EPS_SCF 1.0E-6
      IGNORE_CONVERGENCE_FAILURE
      MAX_SCF 320
      SCF_GUESS RESTART
      &OT
        ALGORITHM IRAC
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_SINGLE_INVERSE
        ROTATION
      &END OT
      &PRINT
        &RESTART ON
          BACKUP_COPIES 0
          &EACH
            QS_SCF 20
          &END EACH
        &END RESTART
      &END PRINT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
    &END CELL
    &COORD
      Al        -0.4201082476       -0.4201082770       -0.4201082658
      Al         2.1120503717        0.1540265147        0.1540265525
      Al         0.1540266214        2.1120506065        0.1540265605
      Al         0.1540266183        0.1540265196        2.1120505165
    &END COORD
    &KIND Al
      BASIS_SET DZVP-GTH-PADE-CONFINED
      POTENTIAL GTH-PADE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

! Slow/manual fixed-N Mermin companion. This input is intentionally not listed
! in TEST_FILES.toml so that the default regtest remains cheap. The isolated C
! atom has a threefold-degenerate p frontier: at 300 K the converged solution
! must retain fractional occupations instead of freezing an integer branch.
! Local 2026-08 O3 references: ADDED_MOS AUTO grows 4->8->11 and converges in
! roughly 245-250 OT steps to F = -5.342248855018 Ha with
! -T*S = -0.003628301102 Ha.
! Independent diagonalization gives the same values within 4E-12 Ha and
! 2E-14 Ha, respectively. No first/last-band warning is printed.
&GLOBAL
  PRINT_LEVEL HIGH
  PROJECT C_kp_ot_fermi_degenerate_converge
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 1 1 1
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 100
    &END MGRID
    &POISSON
      PERIODIC NONE
      PSOLVER WAVELET
    &END POISSON
    &QS
      EPS_DEFAULT 1.0E-10
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-6
      MAX_SCF 500
      SCF_GUESS ATOMIC
      &OT
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        OCCUPATION_PRECONDITIONER
        ROTATION
      &END OT
      &PRINT
        &RESTART OFF
        &END RESTART
      &END PRINT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL PADE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 12.0 12.0 12.0
      PERIODIC NONE
    &END CELL
    &COORD
      C 6.0 6.0 6.0
    &END COORD
    &KIND C
      BASIS_SET DZVP-GTH-PADE
      POTENTIAL GTH-PADE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

! Slow/manual four-channel companion for spin- and symmetry-resolved metallic
! k-point OT. This input is intentionally not listed in TEST_FILES.toml. It
! covers two spin channels, two irreducible k-points with nontrivial weights,
! a fixed magnetic moment, complex FULL_ALL response, and fractional Fermi
! support through the complete fixed-N Mermin minimization.
!
! Local 2026-08 OMP_NUM_THREADS=2, MPI-2 reference from a fresh directory:
! the uninterrupted OT run converges in 109 steps at EPS_SCF 1E-6, with
! Mermin F = -8.14036050082808 Ha and kTS = -0.000169187697 Ha. A matching
! diagonalization run converges to -8.14036093712786 Ha, so the free-energy
! difference is 4.4E-7 Ha. The weighted spin populations remain 7 and 5;
! its restart companion restores all four channels in one step with identical
! free energy, entropy, chemical potential, and fixed magnetic moment.
&GLOBAL
  PRINT_LEVEL HIGH
  PROJECT Al_kp_ot_uks_full_all_sym3_converge
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    MULTIPLICITY 3
    POTENTIAL_FILE_NAME POTENTIAL
    UKS TRUE
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 3 1 1
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 40
    &END MGRID
    &PRINT
      &KPOINTS ON
      &END KPOINTS
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS 12
      EPS_SCF 1.0E-6
      MAX_SCF 180
      SCF_GUESS ATOMIC
      &OT
        ALGORITHM IRAC
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_ALL
        ROTATION
      &END OT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        FIXED_MAGNETIC_MOMENT 2.0
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
    &END CELL
    &COORD
      Al        -0.4201082476       -0.4201082770       -0.4201082658
      Al         2.1120503717        0.1540265147        0.1540265525
      Al         0.1540266214        2.1120506065        0.1540265605
      Al         0.1540266183        0.1540265196        2.1120505165
    &END COORD
    &KIND Al
      BASIS_SET DZVP-GTH-PADE-CONFINED
      MAGNETIZATION 0.5
      POTENTIAL GTH-PADE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

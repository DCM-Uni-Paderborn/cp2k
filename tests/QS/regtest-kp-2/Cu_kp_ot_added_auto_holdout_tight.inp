! Tight, intentionally unregistered physics companion to
! Cu_kp_ot_added_auto_holdout.inp. Run in the same directory after the writer.
! The first inner cycle retains 20 safeguarded CG/line-search evaluations;
! OUTER_SCF then hands the complete complex fixed-N state to DIIS. The
! MPI-2/OMP-1 v40 reference converges in 20+83 evaluations at EPS_SCF=1E-8 and
! F=-48.10314645439306 Ha; its own restart closes in one step. Keeping this
! input out of TEST_FILES.toml avoids adding the long density-tail closure to
! the default regression suite.
&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT Cu_kp_ot_added_auto_holdout
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 3 3 3
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 120
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-9
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_DIIS 2.0E-6
      EPS_SCF 1.0E-8
      MAX_SCF 20
      SCF_GUESS RESTART
      &OT
        MAX_SCF_DIIS 180
        MINIMIZER CG
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-8
        MAX_SCF 1
      &END OUTER_SCF
      &SMEAR
        ELECTRONIC_TEMPERATURE 1000
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 2.55619 2.55619 2.55619
      ALPHA_BETA_GAMMA 60 60 60
    &END CELL
    &COORD
      SCALED
      Cu 0.0 0.0 0.0
    &END COORD
    &KIND Cu
      BASIS_SET DZV-GTH-PADE
      POTENTIAL GTH-PADE-q11
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

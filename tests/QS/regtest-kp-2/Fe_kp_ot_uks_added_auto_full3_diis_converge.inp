! Slow/manual full-grid counterpart of the symmetry-reduced fixed-moment Fe
! metallic OT case. It is intentionally not listed in TEST_FILES.toml so the
! default regression suite remains inexpensive. The case exercises six
! complex (spin,k-point) channels, ADDED_MOS AUTO, and multi-group Pulay
! response without irreducible-k-point weights. The 2026-08 MPI-2/OMP-2
! reference grows (4,6)->(8,10)->(16,18) and converges in 199 final-space
! steps at F=-123.63311571681535 Ha.
&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT Fe_kp_ot_uks_added_auto_full3_diis_converge
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    MULTIPLICITY 3
    POTENTIAL_FILE_NAME POTENTIAL
    UKS TRUE
    &KPOINTS
      FULL_GRID ON
      SCHEME MONKHORST-PACK 3 1 1
      SYMMETRY OFF
    &END KPOINTS
    &MGRID
      CUTOFF 300
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-6
      MAX_SCF 320
      SCF_GUESS ATOMIC
      &OT
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER DIIS
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_ALL
        ROTATION
      &END OT
      &SMEAR
        ELECTRONIC_TEMPERATURE 1000
        FIXED_MAGNETIC_MOMENT 2.0
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &FIT_CHARGE OFF
    &END FIT_CHARGE
  &END PROPERTIES
  &SUBSYS
    &CELL
      A -1.435 1.435 1.435
      B 1.435 -1.435 1.435
      C 1.435 1.435 -1.435
    &END CELL
    &COORD
      Fe 0.000 0.000 0.000
    &END COORD
    &KIND Fe
      BASIS_SET DZVP-MOLOPT-SR-GTH-q16
      MAGNETIZATION 2.0
      POTENTIAL GTH-PADE-q16
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

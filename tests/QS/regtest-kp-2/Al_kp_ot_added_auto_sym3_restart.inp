! Manual restart companion for Al_kp_ot_added_auto_sym3_converge.inp.
! Run the source input first in the same directory. The two irreducible
! k-point channels and adaptive 16-MO virtual space are restored in one SCF
! step with Mermin F -8.15998707957435 Ha and kTS -0.000908404153 Ha.
! This input is intentionally not listed in TEST_FILES.toml.
&GLOBAL
  PRINT_LEVEL HIGH
  PROJECT Al_kp_ot_added_auto_sym3_restart
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME Al_kp_ot_added_auto_sym3_converge-RESTART.kp
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 3 1 1
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 40
    &END MGRID
    &PRINT
      &KPOINTS ON
      &END KPOINTS
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-6
      MAX_SCF 40
      SCF_GUESS RESTART
      &OT
        ALGORITHM IRAC
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_SINGLE_INVERSE
        ROTATION
      &END OT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
    &END CELL
    &COORD
      Al        -0.4201082476       -0.4201082770       -0.4201082658
      Al         2.1120503717        0.1540265147        0.1540265525
      Al         0.1540266214        2.1120506065        0.1540265605
      Al         0.1540266183        0.1540265196        2.1120505165
    &END COORD
    &KIND Al
      BASIS_SET DZVP-GTH-PADE-CONFINED
      POTENTIAL GTH-PADE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

! One-step cell update from the compact converged metallic OT restart. This
! exercises invalidation and reconstruction of the complex k-point OT state
! after the cell metric changes while retaining the adaptive eight-MO space.
&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT Al_kp_ot_cell_opt
  RUN_TYPE CELL_OPT
&END GLOBAL

&MOTION
  &CELL_OPT
    KEEP_ANGLES TRUE
    KEEP_SYMMETRY TRUE
    MAX_ITER 1
    OPTIMIZER BFGS
  &END CELL_OPT
&END MOTION

&FORCE_EVAL
  METHOD Quickstep
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME Al_kp_ot_restart-RESTART.kp
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 3 1 1
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 40
    &END MGRID
    &PRINT
      &KPOINTS ON
      &END KPOINTS
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-7
      MAX_SCF 60
      SCF_GUESS RESTART
      &OT
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        ROTATION
      &END OT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.05 4.05 4.05
    &END CELL
    &COORD
      SCALED
      Al 0.0 0.0 0.0
    &END COORD
    &KIND Al
      BASIS_SET DZVP-GTH-PADE-CONFINED
      POTENTIAL GTH-PADE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

! Manual restart companion for Fe_kp_ot_uks_added_auto_sym3_converge.inp.
! Run the source input first in the same directory. The four complex
! (spin,k-point) channels and adaptive 25-MO spaces must be restored
! without replaying the (4,6)->(8,10)->(16,18) AUTO growth. This input is intentionally
! not listed in TEST_FILES.toml.
! Current MPI-2/OMP-2 reference: one OT FIN step reproduces
! F=-123.63311572142678 Ha and mu=0.40331771881338 Ha exactly.
&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT Fe_kp_ot_uks_added_auto_sym3_restart
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    MULTIPLICITY 3
    POTENTIAL_FILE_NAME POTENTIAL
    UKS TRUE
    WFN_RESTART_FILE_NAME Fe_kp_ot_uks_added_auto_sym3_converge-RESTART.kp
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 3 1 1
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 300
    &END MGRID
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-6
      MAX_SCF 40
      SCF_GUESS RESTART
      &OT
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_ALL
        ROTATION
      &END OT
      &SMEAR
        ELECTRONIC_TEMPERATURE 1000
        FIXED_MAGNETIC_MOMENT 2.0
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &PROPERTIES
    &FIT_CHARGE OFF
    &END FIT_CHARGE
  &END PROPERTIES
  &SUBSYS
    &CELL
      A -1.435 1.435 1.435
      B 1.435 -1.435 1.435
      C 1.435 1.435 -1.435
    &END CELL
    &COORD
      Fe 0.000 0.000 0.000
    &END COORD
    &KIND Fe
      BASIS_SET DZVP-MOLOPT-SR-GTH-q16
      MAGNETIZATION 2.0
      POTENTIAL GTH-PADE-q16
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

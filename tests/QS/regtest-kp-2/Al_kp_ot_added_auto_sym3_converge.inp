! Slow/manual companion to the cheap symmetry-weighted ADDED_MOS AUTO k-point
! OT smoke test. This input is intentionally not listed in TEST_FILES.toml so
! the default regtest stays cheap. It exercises the guarded adaptive AUTO tail
! grow/rebuild path with two irreducible k-points and nontrivial weights.
! Current MPI-4/OMP-1 reference: AUTO grows 4->8->16 and reproducibly converges
! in 54 total SCF steps at -8.159987078117867 Ha. MPI-2/OMP-2 accepted-step
! ordering is threshold-sensitive; five fresh runs required 47--72 steps while
! reaching the same free-energy basin.
! After 32 accepted tail samples, the complete complex orbital residual is
! compared with the independent canonical-density block. A dominant orbital
! block refreshes the physical REF subspace instead of waiting for a path-
! dependent raw-residual mismatch. At 16 MOs the weighted upper edge is empty,
! so AUTO correctly retains the adequate virtual space instead of masking the
! intrinsic minimizer tail by growing to the AO limit.
! No first/last-band, AUTO-exhausted, MAX-ITER, or unsupported-content warning
! is printed. A restart restores either state in one step. Together with the
! full-grid companion this guards weighted symmetry reduction.
&GLOBAL
  PRINT_LEVEL HIGH
  PROJECT Al_kp_ot_added_auto_sym3_converge
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 3 1 1
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 40
    &END MGRID
    &PRINT
      &KPOINTS ON
      &END KPOINTS
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-6
      MAX_SCF 300
      SCF_GUESS ATOMIC
      &OT
        ALGORITHM IRAC
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_ALL
        ROTATION
      &END OT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
    &END CELL
    &COORD
      Al        -0.4201082476       -0.4201082770       -0.4201082658
      Al         2.1120503717        0.1540265147        0.1540265525
      Al         0.1540266214        2.1120506065        0.1540265605
      Al         0.1540266183        0.1540265196        2.1120505165
    &END COORD
    &KIND Al
      BASIS_SET DZVP-GTH-PADE-CONFINED
      POTENTIAL GTH-PADE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

! Slow/manual companion for complex FULL_ALL preconditioning with metallic
! k-point OT. This input is intentionally not listed in TEST_FILES.toml so the
! default regtest does not pay for the adaptive AUTO rebuild stages. It covers
! two irreducible k-points with nontrivial star weights, two collapsed-subspace
! refreshes, and ADDED_MOS AUTO growth from 4 to 8 and 16 orbitals.
!
! Local 2026-07 HIGH reference from a fresh directory: the final 16-MO stage
! converges in 21 OT steps to a Mermin free energy of -8.15998707958001 Ha.
! The FULL_SINGLE_INVERSE companion gives -8.15998708351193 Ha, a difference
! of 3.9e-9 Ha. There is no first/last-band warning, AUTO-exhausted warning,
! preconditioner-positivity failure, or unsupported-content signature.
&GLOBAL
  PRINT_LEVEL HIGH
  PROJECT Al_kp_ot_full_all_sym3_converge
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_SET
    POTENTIAL_FILE_NAME POTENTIAL
    &KPOINTS
      FULL_GRID OFF
      SCHEME MONKHORST-PACK 3 1 1
      SYMMETRY ON
    &END KPOINTS
    &MGRID
      CUTOFF 40
    &END MGRID
    &PRINT
      &KPOINTS ON
      &END KPOINTS
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-8
    &END QS
    &SCF
      ADDED_MOS AUTO
      EPS_SCF 1.0E-6
      MAX_SCF 120
      SCF_GUESS ATOMIC
      &OT
        ALGORITHM IRAC
        ENERGIES
        LINESEARCH 2PNT
        MINIMIZER CG
        OCCUPATION_PRECONDITIONER
        PRECONDITIONER FULL_ALL
        ROTATION
      &END OT
      &SMEAR
        ELECTRONIC_TEMPERATURE 300
        METHOD FERMI_DIRAC
      &END SMEAR
    &END SCF
    &XC
      &XC_FUNCTIONAL Pade
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 6.0 6.0 6.0
    &END CELL
    &COORD
      Al        -0.4201082476       -0.4201082770       -0.4201082658
      Al         2.1120503717        0.1540265147        0.1540265525
      Al         0.1540266214        2.1120506065        0.1540265605
      Al         0.1540266183        0.1540265196        2.1120505165
    &END COORD
    &KIND Al
      BASIS_SET DZVP-GTH-PADE-CONFINED
      POTENTIAL GTH-PADE-q3
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&GLOBAL
  PRINT_LEVEL LOW
  PROJECT helium-gapw
  RUN_TYPE ENERGY
&END GLOBAL
&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
      FULL_GRID T
      SYMMETRY F
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 400
      REL_CUTOFF 100
    &END MGRID
    &PRINT
      &WANNIER90 ON
        KPOINTS_SOURCE NNKP
        NNKP_FILE ${PROPERTY_NNKP}
        SEED_NAME ${CASE}
        STATE_EXPORT T
        SYMMETRY ${PROPERTY_SYMMETRY}
        SYMMETRY_BACKEND ${PROPERTY_BACKEND}
        SYMMETRY_PARALLEL_GROUP_SIZE ${PROPERTY_GROUP_SIZE}
        WILSON_LOOP ${PROPERTY_WILSON}
      &END WANNIER90
    &END PRINT
    &QS
      EPS_DEFAULT 1.0E-12
      METHOD GAPW
    &END QS
    &SCF
      ADDED_MOS -1
      EPS_SCF 1.0E-10
      MAX_SCF 150
      SCF_GUESS ATOMIC
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.4
        METHOD BROYDEN_MIXING
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART
        &RESTART_HISTORY OFF
        &END RESTART_HISTORY
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 4.0 4.0 4.0
    &END CELL
    &COORD
      SCALED
      He 0.5 0.5 0.5
    &END COORD
    &KIND He
      BASIS_SET TZVPP-MOLOPT-GGA-ae
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

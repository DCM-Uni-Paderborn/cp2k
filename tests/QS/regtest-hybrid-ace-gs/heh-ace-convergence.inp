&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT heh-ace-convergence
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    CHARGE 1
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 80
      REL_CUTOFF 30
    &END MGRID
    &QS
      EPS_DEFAULT 1.E-12
      METHOD GPW
    &END QS
    &SCF
      EPS_SCF 1.E-13
      MAX_SCF 120
      SCF_GUESS CORE
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MIXING
        ALPHA 0.3
        METHOD BROYDEN_MIXING
        NBROYDEN 8
      &END MIXING
    &END SCF
    &XC
      &HF
        FRACTION 0.25
        &ACE
          ACTIVE TRUE
          REBUILD_FREQUENCY 1000
        &END ACE
        &INTERACTION_POTENTIAL
          OMEGA 0.6
          POTENTIAL_TYPE SHORTRANGE
        &END INTERACTION_POTENTIAL
        &SCREENING
          EPS_SCHWARZ 1.E-12
        &END SCREENING
      &END HF
      &XC_FUNCTIONAL
        &PBE
          SCALE_X 0.75
        &END PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC [bohr] 12.0 12.4 12.8
      PERIODIC XYZ
    &END CELL
    &COORD
      UNIT bohr
      H 5.3 6.2 6.4
      He 6.9 6.2 6.4
    &END COORD
    &KIND H
      BASIS_SET SZV-MOLOPT-SR-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND He
      BASIS_SET SZV-MOLOPT-SR-GTH-q2
      POTENTIAL GTH-PBE-q2
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

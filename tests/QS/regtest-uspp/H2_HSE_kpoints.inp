&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT H2_USPP_HSE
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  STRESS_TENSOR NONE
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    SORT_BASIS EXP
    &KPOINTS
      FULL_GRID ON
      SCHEME MONKHORST-PACK 2 1 1
      SYMMETRY OFF
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &MGRID
      CUTOFF 40
      REL_CUTOFF 30
    &END MGRID
    &QS
      EPS_DEFAULT 1.E-10
      METHOD GPW
    &END QS
    &SCF
      EPS_SCF 1.E-8
      MAX_SCF 40
      SCF_GUESS ATOMIC
      &OT
        ENERGY_GAP 0.001
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
      &END OT
    &END SCF
    &XC
      &HF
        FRACTION 0.25
        &INTERACTION_POTENTIAL
          OMEGA 0.11
          POTENTIAL_TYPE SHORTRANGE
        &END INTERACTION_POTENTIAL
        &RI
          EPS_FILTER 1.E-10
          KP_NGROUPS 1
          KP_STACK_SIZE 2
          MIN_BLOCK_SIZE 2
          RI_FLAVOR RHO
          RI_METRIC COULOMB
        &END RI
        &SCREENING
          EPS_SCHWARZ 1.E-10
          EPS_SCHWARZ_FORCES 1.E-10
        &END SCREENING
      &END HF
      &XC_FUNCTIONAL
        &PBE
          SCALE_C 1.0
          SCALE_X 0.0
        &END PBE
        &XWPBE
          OMEGA 0.11
          SCALE_X -0.25
          SCALE_X0 1.0
        &END XWPBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 16 16 16
    &END CELL
    &COORD
      H 15.623 3.217 3.331
      H 0.373 3.437 3.521
    &END COORD
    &KIND H
      BASIS_SET SZV-MOLOPT-SR-GTH-q1
      BASIS_SET RI_HFX SZV-MOLOPT-SR-GTH-q1
      POTENTIAL UPF H.pbe-gbrv.UPF
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
